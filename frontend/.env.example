# Copier en .env.local : `cp .env.example .env.local`.
#
# Parcours « frontend seul » : laisser les lignes ci-dessous commentées et
# décommenter le bloc « API publique » pour travailler sur les vraies données,
# sans lancer le backend. Lecture seule : la connexion et l'ajout de serveur
# demandent le backend local.

# --- Backend local (stack complète, backend sur le port 9000) -------------
NEXT_PUBLIC_API_URL=http://localhost:9000/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- API publique (frontend seul) ------------------------------------------
# NEXT_PUBLIC_API_URL=https://api.minecraft-stats.com/api/v1
# NEXT_PUBLIC_BACKEND_URL=https://api.minecraft-stats.com
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Facultatif --------------------------------------------------------------
# Appels serveur (SSR) vers l'API par le réseau Docker en production.
# Inutile en local : NEXT_PUBLIC_API_URL est utilisé à la place.
# INTERNAL_API_URL=
# Hôte des images (S3/CloudFront) quand le backend ne les sert pas lui-même.
# NEXT_PUBLIC_ASSETS_URL=
# Clé de site Cloudflare Turnstile. Vide = pas de captcha.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Jeton de POST /api/revalidate (invalidation ISR déclenchée par le backend).
# REVALIDATE_TOKEN=
# Analytics : laisser vide en local.
# NEXT_PUBLIC_GOOGLE_TAG_MANAGER=
# NEXT_PUBLIC_MICROSOFT_CLARITY=
