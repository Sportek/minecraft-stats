{
  "name": "minecraft-stats-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "Sportek aka Gabriel Landry",
  "description": "Serveur MCP (Model Context Protocol) pour Minecraft Stats — expose les endpoints publics en lecture seule aux agents IA, généré automatiquement depuis le spec OpenAPI du backend.",
  "main": "build/server.js",
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node build/server.js",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector",
    "build:docker": "docker build -t sportek/minecraft-stats-mcp:latest .",
    "push:docker": "docker push sportek/minecraft-stats-mcp:latest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.1.0",
    "yaml": "^2.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  }
}
