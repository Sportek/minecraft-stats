# Copier en .env pour le développement local : `cp .env.example .env`, puis
# `node ace generate:key` pour remplacer APP_KEY. Les valeurs DB_* et REDIS_*
# correspondent à compose.dev.yaml (racine du dépôt).
TZ=UTC
PORT=9000
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=minecraft_stats
DB_PASSWORD=minecraft_stats
DB_DATABASE=minecraft_stats

LIMITER_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=minecraft_stats

# start/env.ts exige ces clés au démarrage. Une valeur factice suffit tant que
# tu ne testes pas les emails (Resend) ou la connexion Discord/Google.
RESEND_API_KEY=dev
DISCORD_CLIENT_ID=dev
DISCORD_CLIENT_SECRET=dev
GOOGLE_CLIENT_ID=dev
GOOGLE_CLIENT_SECRET=dev
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare Turnstile. Vide = captcha désactivé sur l'authentification.
TURNSTILE_SECRET_KEY=
# Jeton attendu sur GET /metrics. Vide = /metrics répond 401.
METRICS_TOKEN=

# Stockage des fichiers. `fs` les écrit sous public/ (servis en local) ;
# `s3` les envoie sur AWS S3 et demande alors les variables AWS_*/S3_*.
DRIVE_DISK=fs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
# URL CloudFront/CDN facultative devant le bucket (sans slash final).
S3_CDN_URL=